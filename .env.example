# ── The engine that costs money ──────────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it to
# every visitor's browser, which is the one thing this whole app exists to stop.
MUAPI_API_KEY=

# Encrypts users' own MuAPI keys at rest. Any long random string.
# Generate with: openssl rand -base64 48
KEY_ENCRYPTION_SECRET=

# ── Database (Neon Postgres, added by the Vercel integration) ────────────────
DATABASE_URL=

# ── Sign-in (Clerk) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Only used if Clerk's invitation-only Access mode is unavailable: a
# comma-separated allowlist enforced in middleware instead.
ALLOWED_EMAILS=

# ── File uploads (Vercel Blob, added by the Vercel integration) ──────────────
BLOB_READ_WRITE_TOKEN=

# ── This deployment ─────────────────────────────────────────────────────────
# The one account allowed into /admin.
ADMIN_EMAIL=

# Public address, no trailing slash, e.g. https://studio.example.com
# Used to build the Claude setup line shown on /connect.
NEXT_PUBLIC_APP_URL=

# ── Daily usage digest email (Resend) ───────────────────────────────────────
RESEND_API_KEY=
DIGEST_TO=
DIGEST_FROM_DOMAIN=

# Guards the daily digest cron route. Any long random string.
CRON_SECRET=
